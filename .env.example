## ChefAI — Environment Variables
## Copy this file to `.env.local` for local development.
## Never commit `.env.local` or any real secrets.

# ──────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ──────────────────────────────────────────────────────────
# Database — Supabase Postgres (added in Step 5)
# ──────────────────────────────────────────────────────────
DATABASE_URL=""
DIRECT_URL=""

# ──────────────────────────────────────────────────────────
# Supabase Storage (added in Step 5)
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ──────────────────────────────────────────────────────────
# Authentication — Clerk (added in Step 6)
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
CLERK_WEBHOOK_SECRET=""

# ──────────────────────────────────────────────────────────
# Payments — Razorpay (added in Step 18)
# ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ──────────────────────────────────────────────────────────
# AI — OpenAI (added in Step 22, abstracted behind a provider interface)
# ──────────────────────────────────────────────────────────
OPENAI_API_KEY=""
AI_PROVIDER="openai"
OPENAI_CHAT_MODEL="gpt-4o-mini"
